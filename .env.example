# Copy this file to .env for local development.
# In production, set these as environment variables in the Render dashboard —
# never commit a real .env file to git.

DATABASE_URL=postgresql://user:password@host:port/railway
JWT_SECRET=replace_with_a_long_random_string
PORT=10000

# Flutterwave — see paymentGateway.js
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-replace_me
FLUTTERWAVE_WEBHOOK_HASH=replace_with_a_long_random_string

# Optional — enables automatic YouTube subscriber-count verification.
# Without it, YouTube submissions fall into the admin manual review queue too.
YOUTUBE_API_KEY=

# Optional — wire in once you have a paid tier / scraping provider.
# See util/socialVerify.js for exactly where these get used.
TWITTER_BEARER_TOKEN=
TIKTOK_SCRAPE_API_KEY=

# Used to build the redirect URL after a successful campaign payment
FRONTEND_ADVERTISER_URL=https://adorbit.vercel.app
FRONTEND_EARNER_URL=https://orbitearn.vercel.app
